{
  "name": "file-chaos-killer",
  "version": "1.0.0",
  "description": "Kill the chaos. Own your files.",
  "author": {
    "name": "File Chaos Killer",
    "email": "app@filechaoskiller.local"
  },
  "homepage": "https://github.com/moritzknopp-jj/Personal-Finance",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "NODE_ENV=development npx electron --no-sandbox .",
    "electron:build": "next build && npm run electron:pack",
    "electron:pack": "electron-builder --linux AppImage deb --x64",
    "electron:pack:win": "electron-builder --win nsis --x64",
    "electron:pack:all": "electron-builder --linux AppImage deb --win nsis --x64"
  },
  "build": {
    "appId": "com.filechaoskiller.app",
    "productName": "File Chaos Killer",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "dist-electron",
      "buildResources": "electron/icons"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      "next.config.mjs"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-cron/**/*",
      "node_modules/next/dist/compiled/**/*"
    ],
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb",      "arch": ["x64"] }
      ],
      "icon": "electron/icons",
      "category": "Utility",
      "synopsis": "Kill the chaos. Own your files.",
      "description": "Organize Downloads/Desktop: auto-sort, duplicate detection, large file cleanup, and scheduled runs."
    },
    "deb": {
      "priority": "optional",
      "depends": []
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "electron/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "File Chaos Killer",
      "installerIcon": "electron/icons/icon.ico",
      "uninstallerIcon": "electron/icons/icon.ico",
      "installerHeaderIcon": "electron/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/icons/icon.png",
      "category": "public.app-category.utilities"
    }
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@types/node-cron": "^3.0.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "14.2.35",
    "node-cron": "^4.2.1",
    "p-limit": "^7.3.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wait-on": "^9.0.5"
  }
}
